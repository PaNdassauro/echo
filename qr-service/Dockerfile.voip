# Imagem com ligação de voz (plugin @zapo-js/voip).
#
# Difere do Dockerfile só no essencial: base Debian (glibc) porque o binário do
# @roamhq/wrtc exige GLIBC 2.34 e não carrega no alpine/musl; e VOIP_ENABLED=1,
# que faz o adapter da zapo importar o plugin.
#
#   docker build -f Dockerfile.voip \
#     --build-arg APP_VERSION=$(node -p "require('./package.json').version") \
#     --build-arg GIT_SHA=$(git rev-parse --short HEAD) -t echo-qr-service:voip .
FROM node:22-bookworm-slim AS builder

WORKDIR /app

COPY package*.json tsconfig.json ./
RUN npm ci

COPY src/ ./src/
RUN npx tsc

FROM node:22-bookworm-slim AS runtime

WORKDIR /app

# tini: init/reaper. ffmpeg: opus das mensagens de voz + decodificação do áudio da ligação.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Reaproveita o node_modules do builder (mesma base) e só remove as devDependencies:
# o tarball do @roamhq/wrtc (~40 MB) caía por ECONNRESET num segundo `npm ci`.
COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
RUN npm prune --omit=dev && npm cache clean --force

COPY --from=builder /app/dist ./dist

RUN mkdir -p /app/sessions

ARG APP_VERSION=dev
ARG GIT_SHA=unknown
# VOIP_MAX_CONCURRENT_CALLS fica no default 1: o servidor do WhatsApp não entrega uma
# segunda oferta para conta que já está em ligação, então >1 só serve para experimento.
ENV APP_VERSION=$APP_VERSION GIT_SHA=$GIT_SHA VOIP_ENABLED=1

EXPOSE 3000

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/index.js"]
