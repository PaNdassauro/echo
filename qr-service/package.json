{
    "name": "echo-qr-service",
    "version": "2.5.17",
    "description": "Serviço de conexão WhatsApp por QR/pairing code do Echo (Baileys e zapo)",
    "license": "MIT",
    "main": "dist/index.js",
    "type": "module",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx watch src/index.ts",
        "test:avatar-queue": "node tests/avatar-queue.mjs",
        "test:message-fallback": "node tests/message-fallback.mjs",
        "test:outbox-sweep": "node tests/outbox-sweep.mjs",
        "check:adapter": "node scripts/check-adapter-imports.mjs",
        "test:secret-edit": "node --import tsx --test tests/secret-edit.test.ts",
        "test:media": "node --import tsx --test tests/resumable-upload.test.ts tests/media-temp.test.ts tests/media-dims.test.ts",
        "test:public-url": "node --import tsx --test tests/public-url.test.ts",
        "test:sessions-dir": "node --import tsx --test tests/sessions-dir.test.ts",
        "test:boot-public-url": "node --import tsx --test --test-force-exit tests/boot-public-url.test.ts",
        "test:qr-sse": "node --import tsx --test --test-force-exit tests/session-qr-sse.test.ts",
        "test:zapo-parity": "node --import tsx --test tests/zapo-parity.test.ts",
        "test:restore-discovery": "node --import tsx --test --test-force-exit tests/restore-discovery.test.ts",
        "test:group-self": "node --import tsx --test tests/group-self.test.ts",
        "test:group-subject": "node --import tsx --test tests/group-subject.test.ts",
        "test:own-profile": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --import tsx --test tests/own-profile.test.ts",
        "test:adapter-contract": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --import tsx --test tests/adapter-contract/*.test.ts",
        "test:zapo-wa-version": "node --import tsx --test tests/zapo-wa-version.test.ts",
        "test:session-health": "node --import tsx --test --test-force-exit tests/session-health-auth.test.ts",
        "test:group-add": "node --import tsx --test tests/group-add.test.ts",
        "test:all": "npm run -s test:message-fallback && npm run -s test:outbox-sweep && npm run -s check:adapter && npm run -s test:secret-edit && npm run -s test:zapo-parity && npm run -s test:group-self && npm run -s test:restore-discovery && npm run -s test:group-subject && npm run -s test:own-profile && npm run -s test:media && npm run -s test:public-url && npm run -s test:sessions-dir && npm run -s test:qr-sse && npm run -s test:boot-public-url && npm run -s test:adapter-contract && npm run -s test:zapo-wa-version && npm run -s test:group-add && npm run -s test:session-health && npm run -s test:avatar-queue"
    },
    "dependencies": {
        "@roamhq/wrtc": "^0.10.0",
        "@supabase/supabase-js": "^2.47.10",
        "@types/multer": "^2.0.0",
        "@whiskeysockets/baileys": "npm:baileys@7.0.0-rc14",
        "@zapo-js/store-postgres": "^1.2.0",
        "@zapo-js/voip": "^1.1.0",
        "audio-decode": "^2.2.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "libmlow-wasm": "^0.1.1",
        "link-preview-js": "^3.2.0",
        "multer": "^2.0.2",
        "node-cache": "^5.1.2",
        "pg": "^8.23.0",
        "pino": "^9.6.0",
        "qrcode": "^1.5.4",
        "sharp": "^0.34.5",
        "wa-store-migrate": "^0.1.1",
        "ws": "^8.21.3",
        "zapo-js": "^1.12.0"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^22.10.5",
        "@types/pg": "^8.23.1",
        "@types/qrcode": "^1.5.5",
        "@types/ws": "^8.18.1",
        "@zapo-js/fake-server": "^1.3.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}
