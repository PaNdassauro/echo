# Echo QR service: configuração por variável de ambiente.
# Copie para .env (`cp .env.example .env`) e preencha. O .env nunca vai para o git.
#
# Atenção: dois serviços apontando para o MESMO projeto Supabase abrem as mesmas
# sessões de WhatsApp e se derrubam com 401 "conflict". Cada projeto (produção,
# teste, local) precisa de exatamente um serviço rodando.

# ---------------------------------------------------------------------------
# OBRIGATÓRIAS (sem elas o serviço recusa subir)
# ---------------------------------------------------------------------------

# URL do projeto Supabase do Echo, no formato https://<ref-do-projeto>.supabase.co
# (ou http://host.docker.internal:54321 para um Supabase local). Também é a base do
# broadcast Realtime, do alerta de desconexão (/functions/v1/send-disconnect-alert)
# e do upload resumível de mídia (/storage/v1/upload/resumable).
SUPABASE_URL=

# Chave service_role LEGADA (JWT) do projeto: o MESMO valor que as edge functions
# recebem em SUPABASE_SERVICE_ROLE_KEY. As edges chamam este serviço com
# 'Authorization: Bearer <essa chave>' e o serviço compara byte a byte; uma chave
# sb_secret_ aqui faz toda chamada das edges dar 401. Também é usada pelo cliente
# admin do supabase-js, pelo broadcast Realtime, pelo upload TUS e pelo alerta de
# desconexão. Nunca exponha no navegador.
SUPABASE_SERVICE_KEY=

# Endereço da edge function de entrada do Echo. O serviço anexa a rota (/qr-message,
# /qr-delivery-update...) a este valor, então ele TERMINA no nome da função, sem
# barra final. Formato: https://<ref-do-projeto>.supabase.co/functions/v1/whatsapp-webhook
WEBHOOK_URL=

# Segredo enviado no header x-qr-secret em todo POST para o webhook. Precisa ser
# IGUAL ao secret QR_WEBHOOK_SECRET da edge whatsapp-webhook. Sem ele o serviço
# recusa subir, e a edge, sem o segredo, RECUSA (503) as rotas /qr-*. Gere com
# `openssl rand -hex 32`.
QR_WEBHOOK_SECRET=

# Senha do Postgres da zapo que o docker-compose.yml sobe junto com o serviço.
# Obrigatória no compose (sem padrão): o `docker compose` recusa subir sem ela.
# Gere com `openssl rand -hex 24` (hexadecimal, seguro dentro da URL de conexão).
# Troque-a só antes do primeiro `up`: o Postgres grava a senha no volume
# zapo_pg na criação, e uma troca depois disso exige recriar o volume ou rodar
# ALTER USER no banco.
ZAPO_PG_PASSWORD=

# ---------------------------------------------------------------------------
# RECOMENDADAS
# ---------------------------------------------------------------------------

# Origens permitidas no CORS (lista separada por vírgula). Em produção, inclua a
# origem (esquema://host[:porta]) onde o front do Echo é servido, ex.:
# https://echo.exemplo.com. Chamadas servidor para servidor não passam por CORS.
# Padrão: http://localhost:8080,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Porta HTTP do serviço. Padrão: 3000
PORT=3000

# Endereço PÚBLICO do Echo (o que o navegador abre), ex.: https://echo.exemplo.com
# ou http://localhost:8088, sem barra final. Só preencha quando SUPABASE_URL for um
# endereço INTERNO (o Echo auto-hospedado em Docker usa http://gateway:8000, que o
# navegador não abre): a URL pública de toda mídia e foto gravada no banco usa este
# valor, e uma media_url do próprio Storage nesse endereço é baixada pela URL interna
# sem passar pela guarda SSRF. Sem ela vale a SUPABASE_URL (Supabase hospedado ou
# local): nada muda. Não é por onde o serviço chama o Supabase.
# ECHO_PUBLIC_URL=

# ---------------------------------------------------------------------------
# PROVIDER ZAPO (opcional)
# ---------------------------------------------------------------------------

# Postgres próprio da zapo (não é o do Supabase). Sem esta variável o provider zapo
# não é registrado e só o Baileys fica disponível. No docker-compose.yml já vem um
# Postgres e esta variável é definida para ele, montada com ZAPO_PG_PASSWORD.
# ZAPO_PG_URL=postgres://zapo:<senha>@localhost:5432/zapo

# Prefixo das tabelas da zapo nesse Postgres. Padrão: wa_zapo_
# ZAPO_PG_TABLE_PREFIX=wa_zapo_

# ---------------------------------------------------------------------------
# MÍDIA (opcionais; valores em bytes)
# ---------------------------------------------------------------------------

# Teto de mídia recebida. Acima disso a mensagem chega sem o arquivo
# (media_too_large). O file_size_limit do bucket attachments deve acompanhar.
# Padrão: 52428800 (50 MiB)
# MAX_MEDIA_BYTES=52428800

# Acima deste tamanho a mídia vai em stream para disco e sobe por upload
# resumível (TUS), sem passar inteira pela memória. Padrão: 16777216 (16 MiB)
# MEDIA_STREAM_THRESHOLD_BYTES=16777216

# Folga mínima de disco que os temporários de mídia sempre deixam livre (as
# credenciais das sessões moram no mesmo disco). Padrão: 2147483648 (2 GiB)
# MEDIA_DISK_RESERVE_BYTES=2147483648

# ---------------------------------------------------------------------------
# ENTREGA AO ECHO (opcional)
# ---------------------------------------------------------------------------

# Teto de webhooks pendentes em memória. O excedente vai para o disco
# (sessions/_outbox/) e é reenviado depois. Padrão: 500
# MAX_PENDING_WEBHOOKS=500

# ---------------------------------------------------------------------------
# PROTEÇÕES CONTRA RESTRIÇÃO DE NÚMERO (opcionais)
# ---------------------------------------------------------------------------

# Espaçamento aleatório entre envios da MESMA sessão, em ms. Liga quando
# SEND_MAX_GAP_MS > 0 (se for menor que SEND_MIN_GAP_MS, sobe para ele); 0 =
# desligado (padrão), porque atendimento em tempo real não pode esperar.
# Exemplo: 1000 e 3000.
# SEND_MIN_GAP_MS=0
# SEND_MAX_GAP_MS=0

# Com o espaçamento ligado, recusa o envio que esperaria mais do que isto (ms).
# Padrão: 60000
# SEND_MAX_QUEUE_WAIT_MS=60000

# Contatos novos distintos por hora, por sessão. 0 desliga. Padrão: 20
# NEW_CONTACT_HOURLY_CAP=20

# Pareamentos (QR ou código) por número por hora. Padrão: 5 (0 vira 5)
# QR_HOURLY_CAP=5

# Cooldown (ms) do connect manual depois de 401/403 em sessão que já estava
# registrada: re-parear logo em seguida agrava a restrição. 0 desliga.
# Padrão: 1800000 (30 min)
# CONNECT_COOLDOWN_AFTER_FATAL_MS=1800000

# Intervalo (ms) entre as reconexões de sessões no boot. Padrão: 3000
# RESTORE_STAGGER_MS=3000

# ---------------------------------------------------------------------------
# LIGAÇÃO DE VOZ (opcional, só no provider zapo)
# ---------------------------------------------------------------------------

# 1 liga a ligação de voz (plugin @zapo-js/voip). Só funciona na imagem
# Dockerfile.voip (base Debian), que já define VOIP_ENABLED=1.
# VOIP_ENABLED=1

# Ligações simultâneas por linha (mínimo 1). Padrão: 1
# VOIP_MAX_CONCURRENT_CALLS=1

# ---------------------------------------------------------------------------
# BUILD (opcionais; ARG do Dockerfile, lidas pelo /health)
# ---------------------------------------------------------------------------

# Versão e commit que o /health informa. Sem APP_VERSION vale a versão do
# package.json; sem GIT_SHA o commit aparece como "unknown".
# APP_VERSION=
# GIT_SHA=

# ---------------------------------------------------------------------------
# DOCKER COMPOSE (só lidas pelo docker-compose.yml)
# ---------------------------------------------------------------------------

# Porta publicada no host. Padrão: 3000
# QR_PORT=3000
