# Variáveis do Echo auto-hospedado (docker compose). Este arquivo é o MODELO: os segredos abaixo são
# placeholders que a guarda do banco recusa de propósito. Quem gera o .env de verdade é o ./install.sh
# (docker/tools/gen-keys.mjs): não copie este arquivo para .env.
# Variáveis do front em desenvolvimento (VITE_*): .env.development.example.

# --- Instalação ---
# Nome do projeto Docker Compose (prefixo de contêineres, volumes e imagens).
COMPOSE_PROJECT_NAME=echo
# Arquivos do compose, separados por ':'. O `docker compose` e o ./echo leem esta linha.
COMPOSE_FILE=docker-compose.yml

# --- Endereço ---
# Uma única URL pública, sem barra final. Fica gravada no banco (mídias, links): para trocar de endereço, reinstale.
ECHO_PUBLIC_URL=http://localhost:8088
# ':80' = HTTP puro; um domínio = HTTPS automático.
ECHO_SITE_ADDRESS=:80
ECHO_BIND=127.0.0.1
ECHO_HTTP_PORT=8088
# Só no modo domínio.
ECHO_HTTPS_PORT=
ECHO_BEHIND_PROXY=false
# Rede Docker externa do proxy reverso (só com --proxy-network).
ECHO_PROXY_NETWORK=

# --- Segredos (gerados; não versionar e guardar no backup) ---
# Perder VAULT_ROOT_KEY, AI_KEY_SECRET ou JWT_SECRET torna ilegíveis o Vault e as chaves de IA; sem este arquivo
# um backup não restaura. Não troque estes valores numa instalação com dados.
POSTGRES_PASSWORD=__GERE_COM_install.sh__
JWT_SECRET=__GERE_COM_install.sh__
ANON_KEY=__GERE_COM_install.sh__
SERVICE_ROLE_KEY=__GERE_COM_install.sh__
VAULT_ROOT_KEY=__GERE_COM_install.sh__
AI_KEY_SECRET=__GERE_COM_install.sh__
REALTIME_SECRET_KEY_BASE=__GERE_COM_install.sh__
REALTIME_DB_ENC_KEY=__GERE_COM_install.sh__
REALTIME_RELEASE_COOKIE=__GERE_COM_install.sh__
QR_WEBHOOK_SECRET=__GERE_COM_install.sh__
WHATSAPP_VERIFY_TOKEN=__GERE_COM_install.sh__
INSTAGRAM_OAUTH_STATE_SECRET=__GERE_COM_install.sh__
ZAPO_DB_PASSWORD=__GERE_COM_install.sh__
# Código do primeiro acesso (/setup). Vazio desliga a tela de setup.
ECHO_SETUP_TOKEN=__GERE_COM_install.sh__
# Web Push (chaves VAPID). Vazio = sem push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- E-mail (opcional) ---
# Sem SMTP_HOST e sem RESEND_API_KEY o Echo funciona sem e-mail: convite vira link para copiar e a senha se
# redefine por `./echo reset-password`. SMTP_ADMIN_EMAIL é obrigatório quando SMTP_HOST está preenchido.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# starttls | tls | none (vazio = tls na porta 465, senão starttls).
SMTP_SECURE=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Echo
# Alternativa ao SMTP (só as funções; o GoTrue usa apenas SMTP).
RESEND_API_KEY=
EMAIL_FROM=
# Listas separadas por vírgula.
FAILURE_ALERT_EMAILS=
FEEDBACK_EMAILS=
# URL que recebe o formulário de feedback (JSON).
FEEDBACK_WEBHOOK_URL=

# --- Cloud API da Meta (opcional) ---
# Só para linhas business_api: sem o segredo do app o POST do webhook não pode ser verificado.
WHATSAPP_APP_SECRET=
WHATSAPP_APP_SECRET_ENFORCE=true

# --- Instagram (opcional) ---
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_PAGINA_RETORNO=
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_WEBHOOK_REGISTRAR_INVALIDOS=

# --- Limites (opcional) ---
# Vazio = padrão do código (MAX_MEDIA_BYTES 52428800; FN_REQUEST_TIMEOUT_MS 150000).
MAX_MEDIA_BYTES=
FN_REQUEST_TIMEOUT_MS=

# --- Avançado (opcional) ---
# Variáveis de proteção do qr e outros ajustes finos vão em docker-compose.override.yml.
EDGE_INTERNAL_AUTH_ENFORCE=
EDGE_INTERNAL_SECRET_KEYS=
# Hosts exatos (vírgula) que as URLs de webhook podem alcançar na rede local.
ECHO_OUTBOUND_ALLOW_HOSTS=
